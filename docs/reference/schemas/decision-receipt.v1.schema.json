{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://confighub.com/schemas/decision-receipt.v1.schema.json",
  "title": "DecisionReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_receipt_id",
    "created_at",
    "checkpoint_id",
    "intent_id",
    "commit_sha",
    "trust_tier",
    "result",
    "reason",
    "policy_refs",
    "confighub_decision_id",
    "attestation_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "decision-receipt.v1"
    },
    "decision_receipt_id": {
      "type": "string",
      "pattern": "^dr_[a-z0-9]{16}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "pattern": "^ci_[a-z0-9]{16}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "trust_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "result": {
      "type": "string",
      "enum": ["ALLOW", "ESCALATE", "BLOCK"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confighub_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "attestation_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string"
        },
        "execution_receipt_id": {
          "type": "string"
        }
      }
    }
  }
}
